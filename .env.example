# Public API key: safe for browser use; read access still depends on RLS policies.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-key"

# Optional legacy fallback for projects that have not migrated API keys yet.
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-legacy-anon-jwt"

# Private server-only API key. Never use a NEXT_PUBLIC_ prefix or commit its real value.
SUPABASE_SECRET_KEY="sb_secret_your-key"
# Legacy server-only fallback:
# SUPABASE_SERVICE_ROLE_KEY="your-legacy-service-role-jwt"

# Server-side only
GEMINI_API_KEY="your-gemini-api-key"
# Optional: comma-separated Gemini model ids tried in order (grading, OCR, quiz,
# chat and analytics). Leave unset to use the built-in defaults in src/lib/gemini-config.ts.
# GEMINI_MODELS="gemini-3.8-flash,gemini-3.6-flash"

# Domain that resolves in DNS; Supabase Auth uses this private email alias for username logins.
STUDENT_AUTH_EMAIL_DOMAIN=vatly11.com
